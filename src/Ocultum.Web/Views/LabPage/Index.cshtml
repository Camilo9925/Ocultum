@model LabPageViewModel
@{
    ViewData["Title"] = "Laboratório";
    ViewData["Nav"] = "lab";
}

<div class="oc-page-header">
    <h1>Laboratório de esteganálise</h1>
    <p class="text-body-secondary mb-0">Compare uma imagem original com a versão que carrega um segredo e veja por que o Steghide é difícil de detectar &mdash; e por que ele é frágil diante de compressão.</p>
</div>

<div id="lab-app" data-max-cover="@Model.MaxCoverBytes" data-max-pass="@Model.MaxPassphraseLength">
    <section class="card oc-card mb-4" aria-labelledby="h-lab-input">
        <div class="card-body">
            <h2 id="h-lab-input" class="oc-card-title"><span class="oc-step">1</span>Material de análise</h2>

            <div class="btn-group mb-3" role="group" aria-label="Origem do arquivo com segredo">
                <input type="radio" class="btn-check" name="lab-source" id="source-generate" value="generate" checked />
                <label class="btn btn-outline-secondary" for="source-generate"><i class="bi bi-magic me-1"></i>Gerar a partir de uma capa</label>
                <input type="radio" class="btn-check" name="lab-source" id="source-upload" value="upload" />
                <label class="btn btn-outline-secondary" for="source-upload"><i class="bi bi-upload me-1"></i>Já tenho os dois arquivos</label>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div id="lab-cover-drop" class="oc-dropzone oc-dropzone-sm" tabindex="0" role="button" aria-label="Escolher a imagem original">
                        <i class="bi bi-image oc-dropzone-icon" aria-hidden="true"></i>
                        <div class="fw-semibold">Imagem original</div>
                        <div class="small text-body-secondary" id="lab-cover-name">JPEG ou BMP</div>
                        <input id="lab-cover-input" type="file" accept=".jpg,.jpeg,.bmp" hidden />
                    </div>
                </div>
                <div class="col-md-6" id="lab-stego-col" hidden>
                    <div id="lab-stego-drop" class="oc-dropzone oc-dropzone-sm" tabindex="0" role="button" aria-label="Escolher a imagem com segredo">
                        <i class="bi bi-image-fill oc-dropzone-icon" aria-hidden="true"></i>
                        <div class="fw-semibold">Imagem com segredo</div>
                        <div class="small text-body-secondary" id="lab-stego-name">JPEG ou BMP</div>
                        <input id="lab-stego-input" type="file" accept=".jpg,.jpeg,.bmp" hidden />
                    </div>
                </div>
                <div class="col-md-6" id="lab-message-col">
                    <label for="lab-message" class="form-label">Mensagem a esconder</label>
                    <textarea id="lab-message" class="form-control" rows="3" maxlength="200000">Mensagem de teste do laboratório do Ocultum.</textarea>
                    <div class="form-text">Quanto maior a mensagem, mais coeficientes são alterados.</div>
                </div>
                <div class="col-md-6">
                    <label for="lab-pass" class="form-label">Senha</label>
                    <input id="lab-pass" type="password" class="form-control" maxlength="@Model.MaxPassphraseLength" autocomplete="off" spellcheck="false" value="laboratorio" />
                    <div class="form-text">Usada para esconder e, depois, no teste de robustez.</div>
                </div>
            </div>

            <div id="lab-error" class="alert alert-danger mt-3 mb-0" role="alert" hidden></div>

            <button id="lab-analyze" type="button" class="btn oc-btn-primary mt-3" disabled>
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true" hidden></span>
                <i class="bi bi-activity me-1" data-idle-icon></i><span data-label>Analisar</span>
            </button>
        </div>
    </section>

    <div id="lab-results" hidden>
        <section class="card oc-card mb-4" aria-labelledby="h-lab-metrics">
            <div class="card-body">
                <h2 id="h-lab-metrics" class="oc-card-title"><span class="oc-step">2</span>O que mudou?</h2>
                <div id="lab-verdict" class="alert alert-info d-flex gap-2" role="status"></div>
                <div class="row g-3 oc-metrics">
                    <div class="col-6 col-lg-3"><div class="oc-metric"><div class="oc-metric-label">PSNR <i class="bi bi-question-circle" data-bs-toggle="tooltip" data-bs-title="Relação sinal-ruído de pico. Acima de ~40 dB, a diferença é imperceptível ao olho."></i></div><div class="oc-metric-value" id="m-psnr">—</div></div></div>
                    <div class="col-6 col-lg-3"><div class="oc-metric"><div class="oc-metric-label">Entropia (original → com segredo) <i class="bi bi-question-circle" data-bs-toggle="tooltip" data-bs-title="Entropia de Shannon dos valores de cor, em bits por amostra (máx. 8)."></i></div><div class="oc-metric-value" id="m-entropy">—</div></div></div>
                    <div class="col-6 col-lg-3"><div class="oc-metric"><div class="oc-metric-label">Pixels alterados <i class="bi bi-question-circle" data-bs-toggle="tooltip" data-bs-title="Porcentagem de pixels cujo valor mudou em ao menos um canal, depois de decodificar."></i></div><div class="oc-metric-value" id="m-changed">—</div></div></div>
                    <div class="col-6 col-lg-3"><div class="oc-metric"><div class="oc-metric-label">Maior diferença <i class="bi bi-question-circle" data-bs-toggle="tooltip" data-bs-title="Maior variação de valor (0 a 255) em um único canal de um pixel."></i></div><div class="oc-metric-value" id="m-max">—</div></div></div>
                </div>
            </div>
        </section>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <section class="card oc-card h-100" aria-labelledby="h-lab-hist">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <h2 id="h-lab-hist" class="oc-card-title mb-0">Histograma</h2>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Canal de cor">
                                <input type="radio" class="btn-check" name="channel" id="ch-red" value="red" checked /><label class="btn btn-outline-secondary" for="ch-red">R</label>
                                <input type="radio" class="btn-check" name="channel" id="ch-green" value="green" /><label class="btn btn-outline-secondary" for="ch-green">G</label>
                                <input type="radio" class="btn-check" name="channel" id="ch-blue" value="blue" /><label class="btn btn-outline-secondary" for="ch-blue">B</label>
                            </div>
                        </div>
                        <div class="oc-chart"><canvas id="chart-hist" aria-label="Histograma da imagem original e da imagem com segredo" role="img"></canvas></div>
                        <div class="small text-body-secondary mt-2">As duas curvas quase se sobrepõem: o Steghide preserva as estatísticas de primeira ordem.</div>
                    </div>
                </section>
            </div>
            <div class="col-lg-6">
                <section class="card oc-card h-100" aria-labelledby="h-lab-delta">
                    <div class="card-body">
                        <h2 id="h-lab-delta" class="oc-card-title">Diferença por nível</h2>
                        <div class="oc-chart"><canvas id="chart-delta" aria-label="Diferença de contagem por nível de cor" role="img"></canvas></div>
                        <div class="small text-body-secondary mt-2">Contagem com segredo menos contagem original. Barras minúsculas perto de zero.</div>
                    </div>
                </section>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <section class="card oc-card h-100" aria-labelledby="h-lab-compare">
                    <div class="card-body">
                        <h2 id="h-lab-compare" class="oc-card-title">Antes × depois</h2>
                        <div id="compare" class="oc-compare">
                            <img id="compare-before" alt="Imagem original" />
                            <img id="compare-after" alt="Imagem com segredo" />
                            <div id="compare-handle" class="oc-compare-handle" aria-hidden="true"></div>
                        </div>
                        <input id="compare-range" type="range" class="form-range mt-2" min="0" max="100" value="50" aria-label="Deslize para comparar a imagem original com a imagem com segredo" />
                        <div class="d-flex justify-content-between small text-body-secondary"><span>Original</span><span>Com segredo</span></div>
                    </div>
                </section>
            </div>
            <div class="col-lg-5">
                <section class="card oc-card h-100" aria-labelledby="h-lab-diff">
                    <div class="card-body">
                        <h2 id="h-lab-diff" class="oc-card-title">Mapa de diferença</h2>
                        <img id="diff-image" class="img-fluid rounded oc-diff" alt="Mapa de diferença entre as imagens, amplificado" />
                        <div class="small text-body-secondary mt-2">Amplificado <strong id="diff-amp">1</strong>×. Pontos claros são pixels que o Steghide alterou.</div>
                    </div>
                </section>
            </div>
        </div>

        <section class="card oc-card" aria-labelledby="h-lab-robust">
            <div class="card-body">
                <h2 id="h-lab-robust" class="oc-card-title"><span class="oc-step">3</span>Teste de robustez</h2>
                <p class="text-body-secondary">Recomprime o JPEG com segredo, como fazem WhatsApp e redes sociais, e tenta extrair de novo.</p>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="robust-quality" class="form-label">Qualidade JPEG: <strong id="robust-quality-label">85</strong></label>
                        <input id="robust-quality" type="range" class="form-range" min="30" max="99" value="85" />
                    </div>
                    <div class="col-md-6">
                        <button id="robust-run" type="button" class="btn oc-btn-primary">
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true" hidden></span>
                            <i class="bi bi-lightning-charge me-1" data-idle-icon></i><span data-label>Recomprimir e tentar extrair</span>
                        </button>
                    </div>
                </div>
                <div id="robust-result" class="mt-3" role="status" aria-live="polite"></div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script type="module" src="~/js/lab.js" asp-append-version="true"></script>
}
