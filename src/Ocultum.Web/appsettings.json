{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "Port": 5080,
    "PortSearchRange": 20,
    "OpenBrowser": true
  },
  "Steghide": {
    "ExecutablePath": "tools/steghide/steghide.exe",
    "TimeoutSeconds": 60,
    "MaxConcurrency": 2
  },
  "Workspace": {
    "RootPath": null,
    "TtlMinutes": 30,
    "CleanupIntervalMinutes": 5
  },
  "Limits": {
    "MaxCoverBytes": 20971520,
    "MaxPayloadBytes": 20971520,
    "MaxPayloadFiles": 20,
    "MaxPassphraseLength": 128
  }
}
